{
  "name": "holy-grail-war",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "concurrently -k -n server,web \"tsx watch apps/server/src/main.ts\" \"node scripts/wait-for-server.mjs && vite --config apps/web/vite.config.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "node scripts/check-node.mjs",
    "build": "tsc --noEmit && tsup apps/server/src/main.ts --format esm --out-dir dist/server && vite build --config apps/web/vite.config.ts",
    "build:core": "tsup packages/game-core/src/index.ts --format esm --out-dir dist/core",
    "prestart": "node scripts/check-node.mjs",
    "start": "node dist/server/main.js",
    "simulate": "tsx scripts/simulate.ts",
    "simulate:summoning": "tsx scripts/summoning.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "^11.0.0",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.11.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "4.1.11",
    "ws": "^8.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
